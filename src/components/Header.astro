---
import { SITE } from '../lib/site';

const nav = [
  { href: '/projects/', label: '项目' },
  { href: '/notes/', label: '笔记' },
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
const current = nav.filter((n) => isActive(n.href)).at(-1)?.label;
---

<header
  class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
>
  <div class="wrap flex h-16 items-center justify-between gap-3">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${SITE.name} 首页`}>
      <span
        class="grid size-8 place-items-center rounded-[9px] bg-ink text-[15px] font-black text-bg transition-colors group-hover:bg-accent group-hover:text-white"
        aria-hidden="true">C</span
      >
      <span class="text-[17px] font-bold tracking-tight">
        CHUN<span class="text-accent">折腾</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 text-[14px] sm:flex" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-1.5 transition-colors',
              isActive(item.href)
                ? 'bg-soft font-semibold text-ink'
                : 'text-ink-soft hover:bg-soft hover:text-ink',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-0.5">
      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-lg text-ink-soft transition-colors hover:bg-soft hover:text-ink"
        aria-label="切换深色 / 浅色模式"
        title="切换深浅色"
      >
        <svg
          class="size-[18px] dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg
          class="hidden size-[18px] dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
        </svg>
      </button>

      <a
        href="/rss.xml"
        class="grid size-9 place-items-center rounded-lg text-ink-soft transition-colors hover:bg-soft hover:text-ink"
        aria-label="RSS 订阅"
        title="RSS 订阅"
      >
        <svg
          class="size-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1.6" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>

      <details class="relative sm:hidden">
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center rounded-lg text-ink-soft transition-colors hover:bg-soft hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label={current ? `当前：${current}，打开菜单` : '打开菜单'}
        >
          <svg
            class="size-[18px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="card absolute right-0 z-50 mt-2 flex w-36 flex-col p-1.5">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'rounded-lg px-3 py-2 text-sm',
                  isActive(item.href)
                    ? 'bg-soft font-semibold text-ink'
                    : 'text-ink-soft hover:bg-soft hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', function () {
    var root = document.documentElement;
    var dark = root.classList.toggle('dark');
    root.style.colorScheme = dark ? 'dark' : 'light';
    try {
      localStorage.setItem('chun-theme', dark ? 'dark' : 'light');
    } catch (e) {}
  });
</script>
