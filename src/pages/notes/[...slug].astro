---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import { formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('notes');
  return entries
    .filter((e) => !e.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const all = (await getCollection('notes')).filter((n) => !n.data.draft);
const sorted = [...all].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = sorted.findIndex((n) => n.id === entry.id);
const prev = idx > 0 ? sorted[idx - 1] : null;
const next = idx < sorted.length - 1 ? sorted[idx + 1] : null;
---

<Base title={d.title} description={d.summary ?? d.title} ogType="article">
  <article class="wrap">
    <div class="mx-auto max-w-2xl">
      <a href="/notes/" class="mb-6 inline-flex items-center gap-1.5 text-[13px] text-ink-mute hover:text-accent">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M19 12H5m0 0 6-6m-6 6 6 6"></path></svg>
        折腾笔记
      </a>

      <header class="mb-8">
        <time class="font-mono text-[12.5px] text-ink-mute" datetime={formatDate(d.date)}>
          {formatDate(d.date)}
        </time>
        <h1 class="mt-2 text-[26px] font-black leading-[1.25] tracking-tight text-ink sm:text-[32px]">
          {d.title}
        </h1>
      </header>

      <div class="article">
        <Content />
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-2 border-t border-line pt-6">
        <span class="mr-1 text-[12px] text-ink-mute">标签</span>
        <TagList tags={d.tags} />
      </div>

      <nav class="mt-8 grid gap-3 border-t border-line pt-6 sm:grid-cols-2" aria-label="笔记翻页">
        {
          prev ? (
            <a href={`/notes/${prev.id}/`} class="group rounded-xl border border-line p-4 transition-colors hover:border-line-strong">
              <span class="text-[11.5px] text-ink-mute">← 前一条</span>
              <p class="mt-1 line-clamp-1 text-[13.5px] font-semibold text-ink group-hover:text-accent">{prev.data.title}</p>
            </a>
          ) : (
            <span></span>
          )
        }
        {
          next && (
            <a href={`/notes/${next.id}/`} class="group rounded-xl border border-line p-4 text-right transition-colors hover:border-line-strong">
              <span class="text-[11.5px] text-ink-mute">后一条 →</span>
              <p class="mt-1 line-clamp-1 text-[13.5px] font-semibold text-ink group-hover:text-accent">{next.data.title}</p>
            </a>
          )
        }
      </nav>
    </div>
  </article>
</Base>
