---
import Base from '../layouts/Base.astro';
---

<Base title="页面不存在" noindex={true}>
  <div class="wrap">
    <div class="mx-auto max-w-lg py-16 text-center">
      <p class="font-mono text-[72px] font-black leading-none text-accent">404</p>
      <h1 class="mt-4 text-[22px] font-bold text-ink">这条链接是空的</h1>
      <p class="mt-2 text-[14px] text-ink-soft">
        可能地址拼错了，也可能这个项目被我删了。
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-2.5">
        <a href="/" class="btn btn-solid">回首页</a>
        <a href="/projects/" class="btn">看项目</a>
      </div>
    </div>
  </div>
</Base>
